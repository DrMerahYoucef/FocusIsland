<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base window theme. Compose draws everything; this only sets the window background
         so there is no white flash before the first frame. -->
    <style name="Theme.MyApplication" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/fi_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Splash screen (androidx.core:core-splashscreen), then Theme.MyApplication. -->
    <style name="Theme.FocusIsland.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/fi_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.MyApplication</item>
    </style>
</resources>
