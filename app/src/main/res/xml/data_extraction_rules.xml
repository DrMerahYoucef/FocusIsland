<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Same rules for cloud backup and device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="focusflow_secure.xml" />
        <exclude domain="sharedpref" path="focusflow_timer_state.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="focusflow_secure.xml" />
        <exclude domain="sharedpref" path="focusflow_timer_state.xml" />
    </device-transfer>
</data-extraction-rules>
